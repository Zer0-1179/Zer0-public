---
interface Props {
  src: string;
  /** 拡大表示（ライトボックス）時だけ使う高精細版。省略時はsrcをそのまま使う。
   * 構成図のアニメーション付きSVG等、初期表示には重すぎるがズーム時なら許容できる画像を渡す用途。 */
  hiresSrc?: string;
  alt: string;
  imgClass?: string;
}

const { src, hiresSrc, alt, imgClass = 'w-full h-auto rounded' } = Astro.props;
---

<button
  type="button"
  class="lightbox-trigger block w-full appearance-none border-0 bg-transparent p-0 text-left cursor-zoom-in"
  data-lightbox-src={hiresSrc || src}
  data-lightbox-alt={alt}
  aria-label={`${alt}を拡大表示`}
>
  <img src={src} alt={alt} class={imgClass} loading="lazy" />
</button>

<script nonce={Astro.locals.cspNonce}>
  function initLightbox() {
    if (window.__lightboxInited) return;
    window.__lightboxInited = true;

    var MIN_SCALE = 1;
    var MAX_SCALE = 5;

    var overlay = document.createElement('div');
    overlay.id = 'lightbox-overlay';
    overlay.className =
      'fixed inset-0 z-[9999] hidden items-center justify-center overflow-hidden bg-black/90 p-4';
    overlay.innerHTML = `
      <button type="button" id="lightbox-close" aria-label="閉じる"
        class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center text-3xl leading-none text-white/80 hover:text-white">
        &times;
      </button>
      <p class="absolute top-4 left-4 text-xs text-white/60">スクロールで拡大・縮小 / ドラッグで移動・ESCで閉じる</p>
      <img id="lightbox-img" src="" alt="" draggable="false"
        class="max-w-full max-h-full rounded object-contain shadow-2xl select-none touch-none" />
    `;
    document.body.appendChild(overlay);

    var img = overlay.querySelector('#lightbox-img');
    var closeBtn = overlay.querySelector('#lightbox-close');

    var scale = 1;
    var panX = 0;
    var panY = 0;
    var dragging = false;
    var startX = 0;
    var startY = 0;
    var startPanX = 0;
    var startPanY = 0;

    function clamp(v, min, max) {
      return Math.min(max, Math.max(min, v));
    }

    function clampPan() {
      var scaledW = img.offsetWidth * scale;
      var scaledH = img.offsetHeight * scale;
      var maxX = Math.max(0, (scaledW - overlay.clientWidth) / 2);
      var maxY = Math.max(0, (scaledH - overlay.clientHeight) / 2);
      panX = clamp(panX, -maxX, maxX);
      panY = clamp(panY, -maxY, maxY);
    }

    function applyTransform() {
      clampPan();
      img.style.transform = 'translate(' + panX + 'px, ' + panY + 'px) scale(' + scale + ')';
      img.style.cursor = scale > MIN_SCALE ? (dragging ? 'grabbing' : 'grab') : 'default';
    }

    function resetTransform() {
      scale = 1;
      panX = 0;
      panY = 0;
      dragging = false;
      applyTransform();
    }

    function open(src, alt) {
      img.src = src;
      img.alt = alt;
      resetTransform();
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      document.body.style.overflow = '';
    }

    document.addEventListener('click', function (e) {
      var trigger = e.target && e.target.closest ? e.target.closest('.lightbox-trigger') : null;
      if (trigger) {
        e.preventDefault();
        open(trigger.dataset.lightboxSrc || '', trigger.dataset.lightboxAlt || '');
      }
    });

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) close();
    });
    closeBtn.addEventListener('click', close);

    overlay.addEventListener(
      'wheel',
      function (e) {
        if (overlay.classList.contains('hidden')) return;
        e.preventDefault();
        var factor = Math.exp(-e.deltaY * 0.0015);
        var next = clamp(scale * factor, MIN_SCALE, MAX_SCALE);
        scale = next;
        if (scale === MIN_SCALE) {
          panX = 0;
          panY = 0;
        }
        applyTransform();
      },
      { passive: false }
    );

    img.addEventListener('pointerdown', function (e) {
      if (scale <= MIN_SCALE) return;
      dragging = true;
      startX = e.clientX;
      startY = e.clientY;
      startPanX = panX;
      startPanY = panY;
      img.setPointerCapture(e.pointerId);
      applyTransform();
    });

    img.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      panX = startPanX + (e.clientX - startX);
      panY = startPanY + (e.clientY - startY);
      applyTransform();
    });

    function endDrag() {
      if (!dragging) return;
      dragging = false;
      applyTransform();
    }
    img.addEventListener('pointerup', endDrag);
    img.addEventListener('pointercancel', endDrag);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) close();
    });
  }

  initLightbox();
</script>
