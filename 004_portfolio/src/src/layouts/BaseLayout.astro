---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const siteUrl = 'https://www.zer0-infra.com';
const ogTitle = `${title} | Zer0_Infra`;
const defaultDesc = lang === 'ja'
  ? 'Zer0_Infra - AWS認定10資格を持つクラウドエンジニアのポートフォリオ。金融機関向けAWS基盤構築・サーバーレス自動化システム開発の実績。'
  : 'Zer0_Infra - Cloud Engineer Portfolio. AWS certified (10 certs), financial institution AWS infrastructure, serverless automation.';
const metaDesc = description ?? defaultDesc;
// 2026-07-05 Fableブラッシュアップ: 白背景の構成図がSNSシェア時のデフォルトOGP画像になっていた問題を修正
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}/images/og-default.png`;

// hreflang alternate: 現在のパスからlang segmentだけ差し替えてja/en相互リンクを生成
const pathWithoutLang = Astro.url.pathname.replace(/^\/(ja|en)/, '') || '/';
const hreflangJa = `${siteUrl}/ja${pathWithoutLang}`;
const hreflangEn = `${siteUrl}/en${pathWithoutLang}`;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Zer0_Infra',
  jobTitle: lang === 'ja' ? 'クラウドエンジニア' : 'Cloud Engineer',
  url: siteUrl,
  image: `${siteUrl}/images/profile.jpg`,
  description: defaultDesc,
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: lang === 'ja' ? 'AWS認定資格' : 'AWS Certification',
    numberOfCredentials: 10,
  },
  sameAs: [
    'https://x.com/Zer0_Infra',
    'https://zenn.dev/zer0_infra',
    'https://note.com/zer0_infra',
    'https://github.com/Zer0-1179',
  ],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Zer0_Infra Portfolio',
  url: siteUrl,
  inLanguage: [lang === 'ja' ? 'ja-JP' : 'en-US'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- スクロール入場アニメーション用: JS実行環境であることをペイント前に示す。
         これが無いとno-js環境で要素が消えたままになる（global.cssのjs-animゲート参照） -->
    <script nonce={Astro.locals.cspNonce}>
      document.documentElement.classList.add('js-anim');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDesc} />
    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:site_name" content="Zer0_Infra Portfolio" />
    <meta property="og:image" content={ogImageUrl} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Zer0_Infra" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />
    <!-- hreflang: 日英2言語サイトであることを検索エンジンに明示し重複コンテンツ判定を回避 -->
    <link rel="alternate" hreflang="ja" href={hreflangJa} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="x-default" href={hreflangJa} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 構造化データ: 検索結果でのPerson/WebSite表示強化（資格数等はhasCredentialで表現） -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link id="font-css" rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Inter:wght@400;500;700&display=swap" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Inter:wght@400;500;700&display=swap" /></noscript>
    <script nonce={Astro.locals.cspNonce}>
      var f=document.getElementById('font-css');if(f)f.addEventListener('load',function(){this.rel='stylesheet'},{once:true});
    </script>
    <title>{title} | Zer0_Infra</title>
  </head>
  <body class="bg-navy-900 text-slate-100 font-sans antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script nonce={Astro.locals.cspNonce}>
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function animateCounters(el) {
          if (reduced) return;
          var nums = el.querySelectorAll('[data-count-to]');
          for (var i = 0; i < nums.length; i++) {
            (function (node) {
              var target = parseInt(node.getAttribute('data-count-to'), 10);
              if (isNaN(target)) return;
              var start = performance.now();
              var duration = 700;
              function tick(now) {
                var p = Math.min((now - start) / duration, 1);
                var eased = 1 - Math.pow(1 - p, 3);
                node.textContent = String(Math.round(eased * target));
                if (p < 1) requestAnimationFrame(tick);
                else node.textContent = String(target);
              }
              node.textContent = '0';
              requestAnimationFrame(tick);
            })(nums[i]);
          }
        }

        var targets = document.querySelectorAll('.card-rise, .reveal-io, .hero-anim');
        if (!targets.length) return;

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              animateCounters(entry.target);
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.25 });

        for (var i = 0; i < targets.length; i++) io.observe(targets[i]);
      })();
    </script>
  </body>
</html>
