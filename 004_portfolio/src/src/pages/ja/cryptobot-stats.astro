---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { S3Client, GetObjectCommand } from '@aws-sdk/client-s3';

// 006 CryptoBot の非公開トレード実績ページ。認証は middleware.ts のトークン方式
// （?admin=<トークン> + Cookie、v3.4でBasic認証から移行済み）で行う
// （このファイル自体には認証ロジックを持たせない）。
// stats.json / positions.json は 006 Executor Lambda がそれぞれ取引確定のたび・
// 30分毎のPhase A実行のたびに書き出す非公開S3オブジェクト。
const STATS_BUCKET = 'zer0-cryptobot-stats-s3';
const STATS_KEY = 'stats.json';
const POSITIONS_KEY = 'positions.json';

const PAIR_LABEL: Record<string, string> = {
  btc_jpy: 'BTC/JPY',
  eth_jpy: 'ETH/JPY',
  sol_jpy: 'SOL/JPY',
};
const DIR_LABEL: Record<string, string> = { long: 'ロング', short: 'ショート' };

// 006 CryptoBot Executor（lambda_function.py の TP1_RATIO = 0.3）と一致させること。
// 分割比率を変更する場合はこの2値だけを書き換えれば全表示箇所に反映される
const TP1_RATIO_PCT = 30;
const REMAINDER_RATIO_PCT = 100 - TP1_RATIO_PCT;

interface StatsPoint {
  ts: string;
  pair: string;
  direction: string;
  reason: string;
  pnl_jpy: number;
  // 2026-10-02〜: pnl_jpy は bitbank 約定履歴の実損益（手数料・利息控除後、口座残高の増減と一致）。
  // 内訳は約定履歴で確定した記録のみ持つ（pending/estimate は null）
  gross_pnl_jpy?: number | null;
  fee_jpy?: number | null;
  interest_jpy?: number | null;
  pnl_source?: 'bitbank' | 'pending' | 'estimate';
  cumulative_pnl_jpy: number;
  position_id?: string | null;
}
interface StatsPayload {
  generated_at: string;
  total_pnl_jpy: number;
  total_gross_pnl_jpy?: number;
  total_fee_jpy?: number;
  total_interest_jpy?: number;
  trade_count: number;
  points: StatsPoint[];
}

// active: TP1未約定（全量が初期SLで保護中）/ trailing: TP1約定済み（残量がトレーリングSLで保護中）
interface PositionSnapshot {
  pair: string;
  direction: 'long' | 'short';
  status: 'active' | 'trailing';
  entry_price: number;
  current_price: number;
  atr_jpy: number | null;
  amount: number;
  tp1_price: number | null;
  sl_price?: number;
  trail_sl_price?: number;
  highest_price?: number | null;
  lowest_price?: number | null;
  unrealized_pnl_jpy: number;
  locked_pnl_jpy?: number;
  // 2026-10-02〜: bitbank の未実現手数料（建てた時の分）・利息。決済時にまとめて差し引かれる
  unrealized_fee_jpy?: number;
  unrealized_interest_jpy?: number;
  unrealized_net_pnl_jpy?: number;
}
// 口座照合: JPY残高 = 元本 + 取引記録の合計 + 記録対象外（テスト取引等）。Executor が毎回計算
interface AccountSummary {
  jpy_balance: number;
  capital_jpy: number;
  recorded_pnl_jpy: number;
  excluded_pnl_jpy: number;
  diff_jpy: number;
  matched: boolean;
  pending_count: number;
}
interface PositionsPayload {
  generated_at: string;
  positions: PositionSnapshot[];
  account?: AccountSummary;
}

let stats: StatsPayload | null = null;
let fetchError = false;
let positionsPayload: PositionsPayload | null = null;

try {
  const s3 = new S3Client({ region: process.env.AWS_REGION || 'ap-northeast-1' });
  const obj = await s3.send(new GetObjectCommand({ Bucket: STATS_BUCKET, Key: STATS_KEY }));
  const body = await obj.Body?.transformToString();
  if (body) stats = JSON.parse(body);
} catch (e: any) {
  // stats.json 未生成（トレードなし）は NoSuchKey として想定内。それ以外はエラー表示にする。
  if (e?.name !== 'NoSuchKey') {
    fetchError = true;
    console.error('[cryptobot-stats] stats.json 取得失敗:', e);
  }
}

try {
  const s3 = new S3Client({ region: process.env.AWS_REGION || 'ap-northeast-1' });
  const obj = await s3.send(new GetObjectCommand({ Bucket: STATS_BUCKET, Key: POSITIONS_KEY }));
  const body = await obj.Body?.transformToString();
  if (body) positionsPayload = JSON.parse(body);
} catch (e: any) {
  // positions.json 未生成（デプロイ直後でまだPhase Aが1周していない等）は想定内。
  if (e?.name !== 'NoSuchKey') {
    console.error('[cryptobot-stats] positions.json 取得失敗:', e);
  }
}

const openPositions = positionsPayload?.positions ?? [];
const account = positionsPayload?.account ?? null;
const fmtYen = (v: number) => `${v >= 0 ? '+' : ''}${v.toLocaleString()}円`;
// 実損益は bitbank が小数4桁で計算しているため、円未満も2桁まで表示する（丸めで差異を作らない）
const fmtYen2 = (v: number) =>
  `${v >= 0 ? '+' : ''}${v.toLocaleString('ja-JP', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}円`;
// 手数料・利息は0円なら色を付けない（赤字は実際に差し引かれた額だけ）
// 手数料・利息は「支払った額」なので、正の値を「-」付きで表示する。負の値（メイカーリベートが
// 上回った等、受け取った額）は「+」付き・緑で表示する
const costCls = (v: number | null | undefined) =>
  !v ? 'text-slate-500' : v > 0 ? 'text-red-300' : 'text-green-400';
const fmtCost = (v: number | null | undefined) =>
  v == null
    ? '—'
    : `${v > 0 ? '-' : v < 0 ? '+' : ''}${Math.abs(v).toLocaleString('ja-JP', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}円`;
const fmtPrice = (v: number | null | undefined) => (v == null ? '—' : v.toLocaleString());
// SSR実行環境(Lambda)のデフォルトタイムゾーンはUTCのため、timeZone省略だと
// generated_at(JSTのISO文字列)がUTC表示になってしまう。明示的にJST指定する。
const fmtJST = (iso: string) => new Date(iso).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' });

const points = stats?.points ?? [];

// 勝率・決済ポジション数はポジション単位で集計する（006 weekly_summary Lambdaの
// summarize_trades()と同じロジック）。1ポジションはTP1部分利確＋最終決済の2レコードに
// 分かれることがあり、レコード単位でカウントすると「正味は勝ちポジションなのに片方が
// 小幅マイナス」なケースが1勝1敗に水増しされ、勝率が実態より低く出てしまう（2026-08-20修正）。
// TP1部分利確はポジション継続中の部分決済のため、それ以外の理由が付いたレコードが
// あって初めてそのポジションは「クローズ済み」として勝敗判定の対象にする。
const NON_CLOSING_REASONS = new Set(['TP1部分利確']);
const positionAgg = new Map<string, { pnl: number; closed: boolean }>();
points.forEach((p, i) => {
  const pid = p.position_id ?? `_solo_${i}`;
  const agg = positionAgg.get(pid) ?? { pnl: 0, closed: false };
  agg.pnl += p.pnl_jpy;
  // 「〜（キャンセル前の一部約定）」もポジション継続中の部分決済（006 weekly_summary と同じ判定）
  if (!NON_CLOSING_REASONS.has(p.reason) && !p.reason.includes('キャンセル前の一部約定')) agg.closed = true;
  positionAgg.set(pid, agg);
});
const closedPositions = [...positionAgg.values()].filter((p) => p.closed);
const winCount = closedPositions.filter((p) => p.pnl > 0).length;
const lossCount = closedPositions.length - winCount;
const winRate = closedPositions.length > 0 ? ((winCount / closedPositions.length) * 100).toFixed(1) : null;
const positionCount = closedPositions.length;

// PF（総利益÷総損失、ポジション単位）・平均利益/平均損失。損失0件のときPFは算出不可（—）
const grossWin = closedPositions.filter((p) => p.pnl > 0).reduce((a, p) => a + p.pnl, 0);
const grossLoss = -closedPositions.filter((p) => p.pnl <= 0).reduce((a, p) => a + p.pnl, 0);
const profitFactor = grossLoss > 0 ? (grossWin / grossLoss).toFixed(2) : null;
const avgWin = winCount > 0 ? grossWin / winCount : null;
const avgLoss = lossCount > 0 ? grossLoss / lossCount : null;

// 元本（bitbank信用口座への入金額）。口座残高＝元本＋全約定の実現損益で一致することを
// 2026-10-02に確認済み。入金・出金で元本が変わったらこの値を更新すること
const INITIAL_CAPITAL_JPY = 10000;
// 資金増額の判断基準（006 project_006_scale_up_plan: 累計20件で最低確認・30件で安心ライン）
const SCALE_UP_MIN = 20;
const SCALE_UP_SAFE = 30;

// 最大ドローダウン（累積損益カーブのピークからの最大下落幅）。基準0円を起点に含める。
let peak = 0;
let maxDD = 0;
for (const p of points) {
  peak = Math.max(peak, p.cumulative_pnl_jpy);
  maxDD = Math.max(maxDD, peak - p.cumulative_pnl_jpy);
}

// ── SVG ジオメトリ（サーバーサイドで完全に静的なSVGを組み立てる。クライアントJS不要）──
const W = 720, H = 260;
const padL = 54, padR = 14, padT = 14, padB = 28;
const plotW = W - padL - padR, plotH = H - padT - padB;

const series = [{ cum: 0 }, ...points.map((p) => ({ cum: p.cumulative_pnl_jpy }))];
const cumValues = series.map((s) => s.cum);
const minCum = Math.min(0, ...cumValues);
const maxCum = Math.max(0, ...cumValues);
const yPad = (maxCum - minCum) * 0.15 || 100;
const yMin = minCum - yPad;
const yMax = maxCum + yPad;

const xAt = (i: number) => padL + (series.length > 1 ? (i / (series.length - 1)) * plotW : plotW / 2);
const yAt = (v: number) => padT + plotH - ((v - yMin) / (yMax - yMin)) * plotH;

const linePath = series.map((s, i) => `${i === 0 ? 'M' : 'L'} ${xAt(i).toFixed(1)} ${yAt(s.cum).toFixed(1)}`).join(' ');
const areaPath =
  `M ${xAt(0).toFixed(1)} ${yAt(0).toFixed(1)} ` +
  series.map((s, i) => `L ${xAt(i).toFixed(1)} ${yAt(s.cum).toFixed(1)}`).join(' ') +
  ` L ${xAt(series.length - 1).toFixed(1)} ${yAt(0).toFixed(1)} Z`;

const gridSteps = 4;
const gridLines = Array.from({ length: gridSteps + 1 }, (_, g) => {
  const v = yMin + (g / gridSteps) * (yMax - yMin);
  return { y: yAt(v), label: `${v >= 0 ? '+' : ''}${Math.round(v).toLocaleString()}` };
});

const xLabels =
  points.length > 0
    ? [0, Math.floor((points.length - 1) / 2), points.length - 1]
        .filter((v, i, arr) => arr.indexOf(v) === i)
        .map((i) => ({ x: xAt(i + 1), label: points[i].ts.slice(5, 10) }))
    : [];
---

<BaseLayout title="CryptoBot トレード実績">
  <div class="max-w-4xl mx-auto px-6 py-20">
    <div class="mb-10">
      <p class="text-xs tracking-wide uppercase text-accent-light mb-1">Zer0-CryptoBot &middot; 非公開ページ</p>
      <h1 class="text-3xl font-bold text-white mb-2">トレード実績</h1>
      <div class="w-12 h-0.5 bg-accent mb-4"></div>
      {stats && (
        <p class="text-slate-400 text-sm">最終更新: {fmtJST(stats.generated_at)}</p>
      )}
    </div>

    <div class="mb-10">
      <h2 class="text-lg font-semibold text-white mb-1">現在のポジション</h2>
      {positionsPayload && (
        <p class="text-slate-500 text-xs mb-4">
          スナップショット更新: {fmtJST(positionsPayload.generated_at)}（Executor実行毎・最大30分遅延）
        </p>
      )}

      {openPositions.length === 0 && (
        <div class="p-6 bg-navy-800/40 border border-navy-700 rounded-lg text-slate-300 text-sm">
          現在保有中のポジションはありません。
        </div>
      )}

      {openPositions.length > 0 && (
        <div class="grid gap-4 md:grid-cols-2">
          {openPositions.map((p) => (
            <div class="p-5 bg-navy-800/40 border border-navy-700 rounded-xl">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <span class="font-semibold text-white">{PAIR_LABEL[p.pair] ?? p.pair}</span>
                  <span class={`text-xs px-2 py-0.5 rounded-full ${p.direction === 'long' ? 'bg-green-900/40 text-green-300' : 'bg-red-900/40 text-red-300'}`}>
                    {DIR_LABEL[p.direction] ?? p.direction}
                  </span>
                </div>
                <span class="text-xs px-2 py-0.5 rounded-full bg-accent/20 text-accent-light">
                  {p.status === 'trailing' ? 'トレーリング中（TP1済）' : 'TP1待ち'}
                </span>
              </div>

              <div class="grid grid-cols-3 gap-2 text-sm mb-3">
                <div>
                  <div class="text-xs text-slate-400">エントリー</div>
                  <div class="text-slate-200">{fmtPrice(p.entry_price)}円</div>
                </div>
                <div>
                  <div class="text-xs text-slate-400">現在価格</div>
                  <div class="text-slate-200">{fmtPrice(p.current_price)}円</div>
                </div>
                <div>
                  <div class="text-xs text-slate-400">含み損益（値幅）</div>
                  <div class={`font-semibold ${p.unrealized_pnl_jpy >= 0 ? 'text-green-400' : 'text-red-400'}`}>
                    {fmtYen(p.unrealized_pnl_jpy)}
                  </div>
                </div>
              </div>
              {typeof p.unrealized_net_pnl_jpy === 'number' && (
                <div class="text-xs text-slate-400 mb-3">
                  手数料・利息を引くと
                  <span class={`font-semibold ${p.unrealized_net_pnl_jpy >= 0 ? 'text-green-400' : 'text-red-400'}`}> {fmtYen2(p.unrealized_net_pnl_jpy)}</span>
                  （手数料{fmtCost(p.unrealized_fee_jpy)}・利息{fmtCost(p.unrealized_interest_jpy)}。決済時にまとめて差し引かれ、決済分の手数料は別途かかります）
                </div>
              )}

              {p.status === 'active' && (
                <div class="text-xs text-slate-400 bg-navy-900/40 rounded-lg p-3 leading-relaxed">
                  TP1（一部利確ライン）: <span class="text-slate-200">{fmtPrice(p.tp1_price)}円</span>（全量の{TP1_RATIO_PCT}%）<br />
                  初期SL（損切りライン）: <span class="text-slate-200">{fmtPrice(p.sl_price)}円</span><br />
                  TP1到達で{TP1_RATIO_PCT}%を確定利確し、残り{REMAINDER_RATIO_PCT}%はトレーリングSLでの管理に移行します。
                </div>
              )}

              {p.status === 'trailing' && (
                <div class="text-xs text-slate-400 bg-navy-900/40 rounded-lg p-3 leading-relaxed">
                  <span class="text-slate-200 font-medium">
                    {fmtPrice(p.trail_sl_price)}円まで{p.direction === 'long' ? '下がる' : '戻す'}と、残り{REMAINDER_RATIO_PCT}%が自動決済されます。
                  </span>
                  <br />
                  確保済み利益ライン（トレーリングSL）: <span class="text-green-300 font-medium">{fmtPrice(p.trail_sl_price)}円</span>
                  {typeof p.locked_pnl_jpy === 'number' && (
                    <> （このラインで決済されても残り{REMAINDER_RATIO_PCT}%分で概算 {fmtYen(p.locked_pnl_jpy)}）</>
                  )}
                  <br />
                  {p.direction === 'long' ? (
                    <>これまでの高値: <span class="text-slate-200">{fmtPrice(p.highest_price)}円</span></>
                  ) : (
                    <>これまでの安値: <span class="text-slate-200">{fmtPrice(p.lowest_price)}円</span></>
                  )}
                  <br />
                  固定の利確ラインはなく、{p.direction === 'long' ? '高値からの反落' : '安値からの反発'}が
                  ATR×0.75（≈{p.atr_jpy != null ? Math.round(p.atr_jpy * 0.75).toLocaleString() : '—'}円）に達すると自動決済される方式です。
                  価格が有利な方向に進むほど、このラインも追従して切り上がって（切り下がって）いきます。
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>

    {fetchError && (
      <div class="p-6 bg-red-900/20 border border-red-700/40 rounded-lg text-red-300">
        統計データの取得に失敗しました。時間を置いて再度アクセスしてください。
      </div>
    )}

    {!fetchError && points.length === 0 && (
      <div class="p-6 bg-navy-800/40 border border-navy-700 rounded-lg text-slate-300">
        まだトレード実績がありません。決済が発生すると自動的にここに反映されます。
      </div>
    )}

    {!fetchError && points.length > 0 && (
      <>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="p-4 bg-navy-800/40 border border-navy-700 rounded-lg">
            <div class="text-xs text-slate-400 mb-1">累計損益（手数料・利息控除後）</div>
            <div class={`text-base sm:text-xl font-bold whitespace-nowrap ${stats!.total_pnl_jpy >= 0 ? 'text-green-400' : 'text-red-400'}`}>
              {fmtYen2(stats!.total_pnl_jpy)}
            </div>
          </div>
          <div class="p-4 bg-navy-800/40 border border-navy-700 rounded-lg">
            <div class="text-xs text-slate-400 mb-1">決済ポジション数</div>
            <div class="text-base sm:text-xl font-bold whitespace-nowrap text-white">{positionCount}件</div>
          </div>
          <div class="p-4 bg-navy-800/40 border border-navy-700 rounded-lg">
            <div class="text-xs text-slate-400 mb-1">勝率</div>
            <div class="text-base sm:text-xl font-bold whitespace-nowrap text-white">{winRate}%</div>
            <div class="text-xs text-slate-500 mt-1">{winCount}勝{lossCount}敗</div>
          </div>
          <div class="p-4 bg-navy-800/40 border border-navy-700 rounded-lg">
            <div class="text-xs text-slate-400 mb-1">最大DD</div>
            <div class="text-base sm:text-xl font-bold whitespace-nowrap text-white">{fmtCost(maxDD)}</div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="p-4 bg-navy-800/40 border border-navy-700 rounded-lg">
            <div class="text-xs text-slate-400 mb-1">戦略の利益率（元本比）</div>
            <div class={`text-base sm:text-xl font-bold whitespace-nowrap ${stats!.total_pnl_jpy >= 0 ? 'text-green-400' : 'text-red-400'}`}>
              {stats!.total_pnl_jpy >= 0 ? '+' : ''}{((stats!.total_pnl_jpy / INITIAL_CAPITAL_JPY) * 100).toFixed(2)}%
            </div>
            <div class="text-xs text-slate-500 mt-1">元本 {INITIAL_CAPITAL_JPY.toLocaleString()}円</div>
          </div>
          <div class="p-4 bg-navy-800/40 border border-navy-700 rounded-lg">
            <div class="text-xs text-slate-400 mb-1">PF（総利益÷総損失）</div>
            <div class="text-base sm:text-xl font-bold whitespace-nowrap text-white">{profitFactor ?? '—'}</div>
          </div>
          <div class="p-4 bg-navy-800/40 border border-navy-700 rounded-lg">
            <div class="text-xs text-slate-400 mb-1">平均利益 / 平均損失</div>
            <div class="text-sm font-bold text-white mt-1 leading-relaxed">
              <span class="text-green-400">{avgWin != null ? fmtYen2(avgWin) : '—'}</span>
              <span class="text-slate-500"> / </span>
              <span class="text-red-400">{avgLoss != null ? fmtCost(avgLoss) : '—'}</span>
            </div>
          </div>
          <div class="p-4 bg-navy-800/40 border border-navy-700 rounded-lg">
            <div class="text-xs text-slate-400 mb-1">増額判断までの進捗</div>
            <div class="text-base sm:text-xl font-bold whitespace-nowrap text-white">{positionCount} / {SCALE_UP_MIN}件</div>
            <div class="text-xs text-slate-500 mt-1">
              {positionCount < SCALE_UP_MIN
                ? `最低ラインまであと${SCALE_UP_MIN - positionCount}件（安心ライン${SCALE_UP_SAFE}件）`
                : positionCount < SCALE_UP_SAFE
                  ? `最低ライン到達。安心ラインまであと${SCALE_UP_SAFE - positionCount}件`
                  : '安心ライン到達'}
            </div>
          </div>
        </div>

        {typeof stats!.total_fee_jpy === 'number' && (
          <div class="bg-navy-800/40 border border-navy-700 rounded-xl p-5 mb-8">
            <h2 class="text-sm font-semibold text-white mb-3">損益の内訳</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
              <div>
                <div class="text-xs text-slate-400 mb-1">売買の損益（控除前）</div>
                <div class="text-slate-200 font-semibold">{fmtYen2(stats!.total_gross_pnl_jpy ?? 0)}</div>
              </div>
              <div>
                <div class="text-xs text-slate-400 mb-1">取引手数料</div>
                <div class="text-red-300 font-semibold">{fmtCost(stats!.total_fee_jpy)}</div>
              </div>
              <div>
                <div class="text-xs text-slate-400 mb-1">建玉金利</div>
                <div class="text-red-300 font-semibold">{fmtCost(stats!.total_interest_jpy)}</div>
              </div>
              <div>
                <div class="text-xs text-slate-400 mb-1">実際の損益</div>
                <div class={`font-semibold ${stats!.total_pnl_jpy >= 0 ? 'text-green-400' : 'text-red-400'}`}>{fmtYen2(stats!.total_pnl_jpy)}</div>
              </div>
            </div>
            <p class="text-xs text-slate-500 mt-3">
              Botの戦略トレードについて、bitbankの約定履歴（実現損益・手数料・利息）をそのまま集計しています。テスト取引などの記録対象外の取引は含みません（口座残高との照合は下の「口座照合」を参照）。PF・勝率・平均損益は決済済みのポジション単位で計算しています。
              {points.some((p) => p.pnl_source !== 'bitbank') && ' 一部の記録は約定履歴の反映待ちのため概算で、内訳には含まれていません（次回のBot実行時に確定値へ置き換わります）。'}
            </p>
          </div>
        )}

        {account && (
          <div class={`border rounded-xl p-5 mb-8 ${account.matched ? 'bg-navy-800/40 border-navy-700' : 'bg-red-900/20 border-red-700/40'}`}>
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-sm font-semibold text-white">口座照合</h2>
              <span class={`text-xs px-2 py-0.5 rounded-full ${account.matched ? 'bg-green-900/40 text-green-300' : 'bg-red-900/40 text-red-300'}`}>
                {account.matched ? '一致' : account.pending_count > 0 ? '約定履歴の反映待ち' : '不一致（要確認）'}
              </span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-sm">
              <div>
                <div class="text-xs text-slate-400 mb-1">口座のJPY残高</div>
                <div class="text-slate-200 font-semibold">{account.jpy_balance.toLocaleString('ja-JP', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}円</div>
              </div>
              <div>
                <div class="text-xs text-slate-400 mb-1">元本</div>
                <div class="text-slate-200 font-semibold">{account.capital_jpy.toLocaleString()}円</div>
              </div>
              <div>
                <div class="text-xs text-slate-400 mb-1">戦略トレードの損益</div>
                <div class="text-slate-200 font-semibold">{fmtYen2(account.recorded_pnl_jpy)}</div>
              </div>
              <div>
                <div class="text-xs text-slate-400 mb-1">記録対象外</div>
                <div class="text-slate-200 font-semibold">{fmtYen2(account.excluded_pnl_jpy)}</div>
              </div>
              <div>
                <div class="text-xs text-slate-400 mb-1">差額</div>
                <div class={`font-semibold ${account.matched ? 'text-green-400' : 'text-red-400'}`}>{fmtYen2(account.diff_jpy)}</div>
              </div>
            </div>
            <p class="text-xs text-slate-500 mt-3">
              口座全体の損益は {fmtYen2(account.jpy_balance - account.capital_jpy)}（元本比 {((account.jpy_balance - account.capital_jpy) / account.capital_jpy * 100).toFixed(2)}%）。
              記録対象外は、取引記録の運用開始（2026-06-23）より前の約定と、動作確認のための実弾テスト（2026-07-21・2026-10-02）の実現損益です。
              残高は決済時に動くため、保有中ポジションの損益は含みません。Bot実行毎（30分）に照合し、ずれた場合はメールで通知します。
            </p>
          </div>
        )}

        <div class="bg-navy-800/40 border border-navy-700 rounded-xl p-5 mb-6">
          <h2 class="text-sm font-semibold text-white mb-3">累積損益推移</h2>
          <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto">
            {gridLines.map((g) => (
              <>
                <line x1={padL} x2={W - padR} y1={g.y} y2={g.y} stroke="#1e3a5f" stroke-width="1" />
                <text x={padL - 8} y={g.y + 3} text-anchor="end" fill="#94a3b8" font-size="10.5">{g.label}</text>
              </>
            ))}
            <line x1={padL} x2={W - padR} y1={yAt(0)} y2={yAt(0)} stroke="#2d5282" stroke-width="1" />
            {xLabels.map((l) => (
              <text x={l.x} y={H - 8} text-anchor="middle" fill="#94a3b8" font-size="10.5">{l.label}</text>
            ))}
            <path d={areaPath} fill="#00b4d8" fill-opacity="0.12" />
            <path d={linePath} fill="none" stroke="#00b4d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            {points.map((p, i) => (
              <circle
                cx={xAt(i + 1)}
                cy={yAt(p.cumulative_pnl_jpy)}
                r="4"
                fill={p.pnl_jpy >= 0 ? '#4ade80' : '#f87171'}
                stroke="#112240"
                stroke-width="1.5"
              >
                <title>{`${p.ts.slice(0, 10)} ${PAIR_LABEL[p.pair] ?? p.pair} ${DIR_LABEL[p.direction] ?? p.direction} / ${p.reason} / ${fmtYen2(p.pnl_jpy)}${p.fee_jpy != null ? `（手数料${fmtCost(p.fee_jpy)}・利息${fmtCost(p.interest_jpy)}控除後）` : ''} / 累計${fmtYen2(p.cumulative_pnl_jpy)}`}</title>
              </circle>
            ))}
            <circle
              cx={xAt(series.length - 1)}
              cy={yAt(series[series.length - 1].cum)}
              r="5"
              fill="#00b4d8"
              stroke="#112240"
              stroke-width="2"
            />
          </svg>
          <div class="flex items-center gap-5 mt-3 text-xs text-slate-400">
            <span class="flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full bg-green-400"></span>利確（勝ちトレード）</span>
            <span class="flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full bg-red-400"></span>損切り（負けトレード）</span>
            <span class="text-slate-500 hidden sm:inline">各点にカーソルを合わせると詳細を表示（下のテーブルでも確認できます）</span>
            <span class="text-slate-500 sm:hidden">各トレードの詳細は下のテーブルでご確認ください</span>
          </div>
        </div>

        <details class="bg-navy-800/40 border border-navy-700 rounded-xl p-5" open>
          <summary class="text-sm font-semibold text-white cursor-pointer select-none">取引一覧（新しい順）</summary>
          {/* スマホ・タブレット: 1トレード1カード（横スクロールを作らない） */}
          <div class="lg:hidden mt-4 space-y-3">
            {[...points].reverse().map((p) => (
              <div class="border border-navy-700 rounded-lg p-3 bg-navy-900/30">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <div class="text-slate-200 text-sm font-medium">
                      {PAIR_LABEL[p.pair] ?? p.pair}
                      <span class="text-slate-400 font-normal"> {DIR_LABEL[p.direction] ?? p.direction}</span>
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">{p.ts.slice(0, 10)} ・ {p.reason}</div>
                  </div>
                  <div class={`text-right font-semibold shrink-0 ${p.pnl_jpy >= 0 ? 'text-green-400' : 'text-red-400'}`}>
                    {fmtYen2(p.pnl_jpy)}
                    {p.pnl_source && p.pnl_source !== 'bitbank' && <div class="text-xs text-slate-500 font-normal">（概算）</div>}
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-x-4 gap-y-1 mt-2 pt-2 border-t border-navy-700 text-xs">
                  <div class="flex justify-between"><span class="text-slate-500">控除前</span><span class="text-slate-300">{p.gross_pnl_jpy != null ? fmtYen2(p.gross_pnl_jpy) : '—'}</span></div>
                  <div class="flex justify-between"><span class="text-slate-500">手数料</span><span class={costCls(p.fee_jpy)}>{fmtCost(p.fee_jpy)}</span></div>
                  <div class="flex justify-between"><span class="text-slate-500">利息</span><span class={costCls(p.interest_jpy)}>{fmtCost(p.interest_jpy)}</span></div>
                  <div class="flex justify-between"><span class="text-slate-500">累計</span><span class="text-slate-300">{fmtYen2(p.cumulative_pnl_jpy)}</span></div>
                </div>
              </div>
            ))}
          </div>

          {/* PC: 表形式 */}
          <div class="hidden lg:block mt-4">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-slate-400 text-xs">
                  <th class="text-left py-2 pr-3 whitespace-nowrap">日付</th>
                  <th class="text-left py-2 pr-3 whitespace-nowrap">ペア</th>
                  <th class="text-right py-2 pr-3 whitespace-nowrap">損益</th>
                  <th class="text-right py-2 pr-3 whitespace-nowrap">手数料</th>
                  <th class="text-right py-2 pr-3 whitespace-nowrap">利息</th>
                  <th class="text-right py-2 pr-3 whitespace-nowrap">控除前</th>
                  <th class="text-right py-2 pr-3 whitespace-nowrap">累計</th>
                  <th class="text-left py-2 pr-3 whitespace-nowrap">方向</th>
                  <th class="text-left py-2">決済理由</th>
                </tr>
              </thead>
              <tbody>
                {/* 最近のトレードを上に表示（グラフは時系列順のまま） */}
                {[...points].reverse().map((p) => (
                  <tr class="border-t border-navy-700">
                    <td class="py-2 pr-3 text-slate-300 whitespace-nowrap">{p.ts.slice(0, 10)}</td>
                    <td class="py-2 pr-3 text-slate-300 whitespace-nowrap">{PAIR_LABEL[p.pair] ?? p.pair}</td>
                    <td class={`py-2 pr-3 text-right whitespace-nowrap ${p.pnl_jpy >= 0 ? 'text-green-400' : 'text-red-400'}`}>
                      {fmtYen2(p.pnl_jpy)}{p.pnl_source && p.pnl_source !== 'bitbank' && <span class="text-slate-500">（概算）</span>}
                    </td>
                    <td class={`py-2 pr-3 text-right whitespace-nowrap ${costCls(p.fee_jpy)}`}>{fmtCost(p.fee_jpy)}</td>
                    <td class={`py-2 pr-3 text-right whitespace-nowrap ${costCls(p.interest_jpy)}`}>{fmtCost(p.interest_jpy)}</td>
                    <td class="py-2 pr-3 text-right text-slate-300 whitespace-nowrap">{p.gross_pnl_jpy != null ? fmtYen2(p.gross_pnl_jpy) : '—'}</td>
                    <td class="py-2 pr-3 text-right text-slate-300 whitespace-nowrap">{fmtYen2(p.cumulative_pnl_jpy)}</td>
                    <td class="py-2 pr-3 text-slate-300 whitespace-nowrap">{DIR_LABEL[p.direction] ?? p.direction}</td>
                    <td class="py-2 text-slate-300">{p.reason}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </>
    )}
  </div>
</BaseLayout>
