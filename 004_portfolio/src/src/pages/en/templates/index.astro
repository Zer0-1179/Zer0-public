---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCategoriesWithTemplates, getTemplatesByCategory } from '../../../data/templates';
import { useTranslations } from '../../../i18n/utils';

const t = useTranslations('en');

const DIFFICULTIES = ['advanced', 'beginner'] as const;

const difficulties = DIFFICULTIES.map(diff => {
  const cats = getCategoriesWithTemplates().map(cat => {
    const files = getTemplatesByCategory(cat.slug)
      .filter(t => t.tagsEn.includes(diff === 'advanced' ? 'Advanced' : 'Beginner'));
    return { ...cat, files, count: files.length };
  }).filter(c => c.count > 0);
  return { diff, cats, count: cats.reduce((s, c) => s + c.count, 0) };
});

// For ZIP buttons that still use category slug
const categories = getCategoriesWithTemplates().map((cat) => {
  const files = getTemplatesByCategory(cat.slug);
  return { ...cat, files, count: files.length };
});

const totalFiles = categories.reduce((s, c) => s + c.count, 0);
---

<BaseLayout title={t('templates.title')}>
  <div class="mx-auto px-4 pb-0 md:pb-8">

    <!-- Page header (hidden everywhere — explorer uses full height) -->
    <div class="hidden">
      <h1 class="text-3xl font-bold text-white mb-1.5">{t('templates.title')}</h1>
      <div class="w-10 h-0.5 bg-accent mb-3"></div>
      <p class="text-slate-400 text-sm">{t('templates.sub')}</p>
    </div>

    <!-- ═══════════════════ DESKTOP (md+) ═══════════════════ -->
    <div
      id="templates-explorer"
      data-lang="en"
      class="hidden md:flex border border-navy-700/50 rounded-xl overflow-hidden"
      style="height: calc(100vh - 80px); min-height: 520px"
    >

      <!-- Left: folder tree -->
      <div id="tree-sidebar" class="w-[256px] xl:w-[280px] shrink-0 border-r border-navy-700/50 flex flex-col bg-navy-900/30">

        <div class="flex items-center justify-between px-3 py-2 border-b border-navy-700/40 bg-navy-900/60 shrink-0">
          <button id="tree-root-btn" class="flex items-center gap-1.5 hover:text-accent transition-colors" title="Back to README">
            <svg class="w-4 h-4 text-accent/70" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
            </svg>
            <span class="font-mono text-xs text-white">templates</span>
            <span class="text-slate-600 text-xs">{totalFiles}</span>
          </button>
          <div class="flex items-center gap-0.5">
            <button id="sidebar-toggle" class="p-1 text-slate-500 hover:text-accent hover:bg-navy-700/40 transition-colors rounded" title="Collapse sidebar">
              <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </button>
            <a href="/api/templates/download/all.zip" download="cfn-templates-all.zip" title="Download all"
              class="p-1 text-slate-500 hover:text-accent hover:bg-navy-700/40 transition-colors rounded">
              <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Search -->
        <div class="px-2 py-1.5 border-b border-navy-700/40 shrink-0">
          <div class="flex items-center gap-1.5 px-2 py-1 bg-navy-900/60 border border-navy-700/50 rounded">
            <svg class="w-3 h-3 text-slate-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
            </svg>
            <input id="tree-search" type="text" placeholder="Search filename..."
              class="bg-transparent text-slate-300 placeholder-slate-600 text-[11px] w-full outline-none" />
            <button id="tree-search-clear" class="hidden text-slate-500 hover:text-white text-sm leading-none transition-colors">×</button>
          </div>
        </div>

        <!-- Tree rows: difficulty → category → file -->
        <div class="flex-1 overflow-y-auto py-1">
          {difficulties.map(({ diff, cats, count }) => (
            <div class="folder-group" data-slug={diff}>
              <!-- Level 1: advanced / beginner -->
              <div class="folder-toggle-row flex items-center hover:bg-navy-700/20 cursor-pointer select-none group/folder transition-colors">
                <div class="flex items-center justify-center w-6 h-7 shrink-0 text-slate-600">
                  <svg class="chevron w-2.5 h-2.5 transition-transform duration-150" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="flex items-center gap-1.5 flex-1 min-w-0 py-1.5">
                  <svg class:list={['w-3.5 h-3.5 shrink-0', diff === 'advanced' ? 'text-orange-400/60' : 'text-blue-400/60']} viewBox="0 0 20 20" fill="currentColor">
                    <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                  </svg>
                  <span class="text-xs truncate flex-1 text-slate-300">{diff}/</span>
                  <span class="folder-count text-xs text-slate-600 shrink-0" data-total={count}>{count}</span>
                </div>
                <a
                  href={`/api/templates/download/${diff}.zip`}
                  download={`cfn-templates-${diff}.zip`}
                  title={`Download ${diff} as ZIP`}
                  class="folder-zip-btn w-6 h-7 flex items-center justify-center shrink-0 text-slate-700 hover:text-accent transition-colors opacity-0 group-hover/folder:opacity-100"
                >
                  <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>

              <div class="folder-files hidden">
                {cats.map((cat) => (
                  <!-- Level 2: category (network, compute, …) -->
                  <div class="diff-group" data-diff={diff} data-cat={cat.slug}>
                    <div class="diff-toggle-row flex items-center pl-5 hover:bg-navy-700/20 cursor-pointer select-none group/cat transition-colors">
                      <div class="flex items-center justify-center w-5 h-6 shrink-0 text-slate-600">
                        <svg class="diff-chevron w-2 h-2 transition-transform duration-150" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <div class="flex items-center gap-1.5 flex-1 min-w-0 py-1">
                        <svg class="w-3 h-3 text-accent/40 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                        </svg>
                        <span class="text-xs text-slate-400 truncate flex-1">{cat.slug}/</span>
                        <span class="text-xs text-slate-600 ml-auto pr-1">{cat.count}</span>
                      </div>
                      <a
                        href={`/api/templates/download/${cat.slug}.zip`}
                        download={`cfn-templates-${cat.slug}.zip`}
                        title={`Download ${cat.slug} as ZIP`}
                        class="folder-zip-btn w-6 h-6 flex items-center justify-center shrink-0 text-slate-700 hover:text-accent transition-colors opacity-0 group-hover/cat:opacity-100"
                      >
                        <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                      </a>
                    </div>
                    <!-- Level 3: files -->
                    <div class="diff-files hidden">
                      {cat.files.map((tmpl) => (
                        <button
                          class="file-btn flex items-center gap-1.5 w-full pl-11 pr-2 py-1 text-left hover:bg-navy-700/20 transition-colors group/file"
                          data-filename={tmpl.filename}
                          data-name={tmpl.nameEn}
                          data-short={tmpl.descShortEn}
                          data-desc={tmpl.descEn}
                          data-services={tmpl.services.join(',')}
                          data-tags={tmpl.tagsEn.join(',')}
                          data-cat={cat.slug}
                          data-difficulty={diff}
                          title={tmpl.descShortEn}
                        >
                          <svg class="w-3.5 h-3.5 text-slate-600 group-hover/file:text-slate-400 shrink-0 transition-colors" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                          </svg>
                          <span class="file-label font-mono text-xs text-slate-500 group-hover/file:text-slate-200 truncate transition-colors">
                            {tmpl.filename}
                          </span>
                        </button>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: content pane -->
      <div class="flex-1 overflow-hidden flex flex-col min-w-0">

        <div class="flex items-center border-b border-navy-700/40 bg-navy-900/50 shrink-0">
          <button id="sidebar-show" style="display:none" class="flex items-center justify-center w-8 self-stretch border-r border-navy-700/40 text-slate-500 hover:text-accent transition-colors shrink-0" title="Expand sidebar">
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
          </button>
          <button id="tab-readme"
            class="flex items-center gap-1.5 px-3 py-2 text-xs font-mono border-b-2 border-accent text-white transition-colors">
            <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
            </svg>
            README.md
          </button>
          <button id="tab-file"
            class="hidden flex items-center gap-1.5 px-3 py-2 text-xs font-mono border-b-2 border-transparent text-slate-400 hover:text-white transition-colors">
            <svg class="w-3.5 h-3.5 text-yellow-400/70 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
            </svg>
            <span id="tab-file-name" class="max-w-48 truncate"></span>
            <span id="tab-close" class="ml-1 text-slate-500 hover:text-white transition-colors">×</span>
          </button>
        </div>

        <!-- README panel -->
        <div id="readme-panel" class="flex-1 overflow-y-auto px-5 py-4 space-y-5 text-sm">

          <!-- Header -->
          <div>
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
              </svg>
              <span class="font-mono text-sm text-slate-400">README.md</span>
            </div>
            <p class="text-slate-400 leading-relaxed text-xs">
              CloudFormation templates extracted from real production projects and generalized for public use.
              Each template is ready to deploy as-is — just supply your parameters.
            </p>
          </div>

          <!-- Category list -->
          <div>
            <p class="font-semibold text-slate-300 mb-2 text-xs">Categories</p>
            <div class="grid grid-cols-2 gap-1.5">
              {categories.map((cat) => (
                <div class="flex items-center justify-between px-2.5 py-1.5 bg-navy-900/50 border border-navy-700/40 rounded-lg">
                  <span class="text-xs text-slate-300 font-mono truncate">{cat.slug}</span>
                  <span class="text-[11px] text-slate-500 ml-2 shrink-0">{cat.count}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- 3-step usage -->
          <div>
            <p class="font-semibold text-slate-300 mb-2 text-xs">How to Use</p>
            <ol class="space-y-2.5">
              {([
                ['Pick a template', 'Browse the tree on the left'],
                ['Review the code', 'Ctrl+F to search within the file'],
                ['Download & deploy', 'Adjust Parameters and run the CLI command below'],
              ] as [string, string][]).map(([title, desc], i) => (
                <li class="flex gap-3 items-start">
                  <span class="shrink-0 w-5 h-5 rounded-full bg-accent/20 text-accent text-[10px] flex items-center justify-center font-bold">{i + 1}</span>
                  <div class="text-xs leading-relaxed">
                    <span class="text-slate-300 font-medium">{title}</span>
                    <span class="text-slate-500"> — {desc}</span>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <!-- Design principles -->
          <div>
            <p class="font-semibold text-slate-300 mb-2 text-xs">Design Principles</p>
            <ul class="space-y-1.5 text-slate-400 text-xs">
              <li class="flex gap-2"><span class="text-accent shrink-0">•</span>No hardcoding — all configurable values are exposed as <code class="text-accent/80 bg-navy-700/60 px-1 rounded">Parameters</code></li>
              <li class="flex gap-2"><span class="text-accent shrink-0">•</span><code class="text-accent/80 bg-navy-700/60 px-1 rounded">Env</code> parameter auto-switches dev / stg / prd settings (retention, DeletionPolicy)</li>
              <li class="flex gap-2"><span class="text-accent shrink-0">•</span>Least-privilege IAM, KMS encryption, and cross-stack references (Outputs + ImportValue) included</li>
            </ul>
          </div>

          <!-- Deploy -->
          <div>
            <p class="font-semibold text-slate-300 mb-2 text-xs">Deploy</p>
            <pre class="bg-navy-900/60 border border-navy-700/50 rounded-lg px-4 py-3 text-xs text-slate-300 font-mono overflow-x-auto leading-relaxed">aws cloudformation deploy \
  --stack-name &lt;stack-name&gt; \
  --template-file &lt;template&gt;.yaml \
  --capabilities CAPABILITY_NAMED_IAM \
  --parameter-overrides ProjectName=&lt;name&gt; Env=prd</pre>
          </div>

          <!-- Warning -->
          <div class="flex gap-2 text-slate-400 text-xs">
            <span class="text-yellow-500/80 shrink-0">⚠</span>
            <p>Resources deployed with <code class="text-accent/80 bg-navy-700/60 px-1 rounded">Env=prd</code> have <code class="text-accent/80 bg-navy-700/60 px-1 rounded">DeletionPolicy: Retain</code>. They persist after stack deletion — remove manually via console or CLI when no longer needed.</p>
          </div>
        </div>

        <!-- YAML viewer -->
        <div id="yaml-viewer" class="hidden flex-1 overflow-hidden flex flex-col">
          <div id="yv-breadcrumb"
            class="px-4 py-2 bg-[#161b22] border-b border-[#30363d] flex items-center gap-0 text-xs font-mono text-[#6e7681] shrink-0 overflow-x-auto whitespace-nowrap">
          </div>
          <!-- Code search bar (Ctrl+F) -->
          <div id="code-search-bar" class="hidden px-3 py-1.5 bg-[#161b22] border-b border-[#30363d] flex items-center gap-2 shrink-0">
            <svg class="w-3.5 h-3.5 text-[#6e7681] shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
            </svg>
            <input id="code-search-input" type="text" placeholder="Search in file... (Enter: next / Shift+Enter: prev)"
              class="bg-transparent text-[#c9d1d9] placeholder-[#6e7681] text-xs w-full outline-none" />
            <span id="code-search-count" class="text-[#6e7681] text-xs whitespace-nowrap shrink-0"></span>
            <button id="code-search-prev" class="text-[#6e7681] hover:text-white transition-colors shrink-0" title="Previous match">↑</button>
            <button id="code-search-next" class="text-[#6e7681] hover:text-white transition-colors shrink-0" title="Next match">↓</button>
            <button id="code-search-close" class="text-[#6e7681] hover:text-white transition-colors shrink-0 text-sm leading-none">×</button>
          </div>
          <div class="px-4 py-2 border-b border-navy-700/30 bg-navy-900/20 flex items-center justify-between gap-3 shrink-0">
            <div class="flex items-center gap-2 min-w-0 flex-1">
              <svg class="w-4 h-4 text-yellow-400/60 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
              </svg>
              <span id="yv-name" class="font-mono text-[13px] text-accent font-medium shrink-0"></span>
              <div id="yv-services" class="flex gap-1 flex-wrap"></div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span id="yv-stats" class="text-xs text-[#6e7681] font-mono whitespace-nowrap"></span>
              <div class="flex items-center shrink-0">
                <button id="yv-font-dec" class="px-1.5 py-1 text-slate-500 hover:text-white text-[11px] border border-navy-700/60 rounded-l transition-colors" title="Decrease font size">A-</button>
                <button id="yv-font-reset" class="px-1.5 py-1 text-slate-500 hover:text-white text-[11px] border-t border-b border-navy-700/60 transition-colors" title="Reset to default size">A</button>
                <button id="yv-font-inc" class="px-1.5 py-1 text-slate-500 hover:text-white text-[11px] border border-navy-700/60 rounded-r border-l-0 transition-colors" title="Increase font size">A+</button>
              </div>
              <button id="yv-copy"
                class="flex items-center gap-1 px-2 py-1 border border-navy-700/60 text-slate-400 text-xs rounded hover:text-white hover:border-navy-500 transition-colors">
                <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" />
                  <path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" />
                </svg>
                Copy
              </button>
              <a id="yv-dl" href="#" download
                class="flex items-center gap-1.5 px-3 py-1.5 bg-accent hover:bg-accent-light text-navy-950 text-xs font-semibold rounded transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
                Download
              </a>
            </div>
          </div>
          <div class="px-4 py-1.5 border-b border-[#21262d] bg-[#0d1117]/50 shrink-0">
            <p id="yv-short" class="text-[#8b949e] text-[11px] leading-relaxed"></p>
          </div>
          <div class="flex-1 overflow-auto bg-[#0d1117]">
            <table class="w-max min-w-full border-collapse font-mono text-[12.5px] leading-5">
              <tbody id="yv-body"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════ MOBILE (< md) ═══════════════════ -->
    <div id="mobile-explorer" class="md:hidden flex flex-col border border-navy-700/50 rounded-xl overflow-hidden"
      style="height: calc(100vh - 64px); height: calc(100svh - 64px); min-height: 480px">

      <!-- State 1: Category list -->
      <div id="mob-cat-view" class="flex-1 flex flex-col min-h-0">
        <div class="shrink-0 flex items-center justify-between px-4 py-3 bg-navy-900/60 border-b border-navy-700/40">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent/70" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
            </svg>
            <span class="font-mono text-sm text-white">templates</span>
            <span class="text-slate-500 text-xs">({totalFiles} files)</span>
          </div>
          <a href="/api/templates/download/all.zip" download="cfn-templates-all.zip"
