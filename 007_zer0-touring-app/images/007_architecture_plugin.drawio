        <mxCell id="legend-aux-note" parent="legend-container" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontStyle=2;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#666666,#CCCCCC);" value="&lt;i&gt;SSM(GMaps使用カウント)・CloudWatch Logs・DynamoDB(ratelimit/share)はLambda(suggest)の補助経路。&lt;/i&gt;&lt;div&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;EventBridge→Lambda(stats)→S3は独立した日次バッチ(stats.json生成)。&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;既存の構成図(007_architecture.png)と同じリソース構成・配置に合わせている。&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="450" y="320" as="geometry" />
        </mxCell>
        <mxCell id="external-api-legend" parent="legend-container" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#666666,#CCCCCC);" value="&lt;div&gt;&lt;b&gt;外部API(ジオコーディング・ルーティング、2026-09-06〜)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Lambda(zer0-touring-suggest)は目的地・立寄りスポットの座標取得にGoogle Geocoding API、実道路距離・所要時間の取得にGoogle Routes APIを優先利用する。&lt;/div&gt;&lt;div&gt;いずれも無料枠超過時やエラー時はNominatim(ジオコーディング)・OSRM(ルーティング)へ自動フォールバックする。&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="450" y="420" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-group" parent="legend-outer" style="group;fontFamily=Helvetica;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="120" width="440" x="30" y="590" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-title" parent="legend-line-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;fontStyle=1;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="Line Styles" vertex="1">
          <mxGeometry height="25" width="200" x="10" y="5" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-desc" parent="legend-line-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;- - - アニメーション線&lt;/b&gt;: アクセス〜コース提案の主要フロー・優先APIコール(SVGエクスポート時も流れて表示される)&lt;/div&gt;&lt;div&gt;&lt;b&gt;—— Solid&lt;/b&gt;: 証明書参照・ログ・フォールバックAPI等の補助的な経路&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="420" x="10" y="32" as="geometry" />
        </mxCell>
      </root>
